{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "smart-wall-paint": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "swp",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/smart-wall-paint",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {"budgets":[{"type":"initial","maximumWarning":"2mb","maximumError":"5mb"}],"outputHashing":"all"},
            "development": {"buildOptimizer":false,"optimization":false,"vendorChunk":true,"extractLicenses":false,"sourceMap":true,"namedChunks":true}
          },
          "defaultConfiguration":"development"
        },
        "serve": {
          "builder":"@angular-devkit/build-angular:dev-server",
          "configurations":{"production":{"browserTarget":"smart-wall-paint:build:production"},"development":{"browserTarget":"smart-wall-paint:build:development"}},
          "defaultConfiguration":"development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
